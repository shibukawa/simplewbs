{
  "name": "simplewbs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply simplewbs --local",
    "db:migrate:remote": "wrangler d1 migrations apply simplewbs --remote",
    "deploy": "npm run build && wrangler d1 migrations apply simplewbs --remote && wrangler deploy",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "wrangler": "^4.40.0"
  }
}
